#!/bin/bash
set -eu
#
# start docker container for unifi-stuff
docker run --init -d --restart=always \
{% for port in ['8080:8080', '8443:8443', '3478:3478/udp', '10001:10001/udp'] %}
{% for addr in unifi_docker_bind_addresses or [''] %}
  -p {{ (addr ~ ':') if addr else '' }}{{ port }} \
{% endfor %}
{% endfor %}
  -e TZ='{{ unifi_docker_timezone }}' \
  -v {{ unifi_docker_data_dir }}:/unifi \
  --name {{ unifi_docker_container_name }} \
  {{ unifi_docker_image }}
